{
  "projectType": "sdk-library",
  "projectName": "Sheet.js",
  "projectDescription": "A TypeScript toolkit providing a spreadsheet-like data structure (Workbook → Sheet → Block → Table/List) with JSON serialization, XLSX import/export, and class-transformer integration for modern web and Node.js applications.",
  "theme": "luma",
  "primaryColor": "#2563EB",
  "lightColor": "#DBEAFE",
