  "keyFeatures": [
    "Hierarchical spreadsheet-like data model: Workbook → Sheet → Block (Table | List)",
    "JSON-native serialization and deserialization via class-transformer",
    "XLSX import and export via WorkbookConverter",
    "Table blocks with typed header/row access and column projection",
    "List blocks with key-value Item storage and case-insensitive lookup",
    "Metadata support on all data objects",
    "Date/epoch conversion for columns with 'epoch' in the header name",
    "CJS and ESM dual package output with TypeScript type declarations",
    "Discriminator-based polymorphic deserialization for Block subtypes"
  ],
