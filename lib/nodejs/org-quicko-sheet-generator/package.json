{
	"name": "@org-quicko/sheet-generator",
	"version": "2.0.0",
	"description": "Utility to generate TypeScript classes and schemas from JSON or Excel files.",
	"author": "Quicko <developer@quicko.org.in>",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"type": "module",
	"bin": {
		"json-to-schema": "dist/commands/json-to-schema.cjs",
		"excel-to-schema": "dist/commands/excel-to-schema.cjs",
		"schema-to-objects": "dist/commands/schema-to-object.cjs"
	},
	"scripts": {
		"clean": "npm cache clean --force",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prebuild": "rm -rf dist && eslint .",
		"build": "rollup -c",
		"test": "vitest run",
		"typecheck": "node node_modules/typescript-native/bin/tsc --noEmit"
	},
	"license": "ISC",
	"files": [
		"dist/**/*"
	],
	"exports": {
		".": "./dist/index.cjs"
	},
	"directories": {
		"lib": "./dist"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"dependencies": {
		"@org-quicko/core": "^2.0.7",
		"@org-quicko/sheet": "^2.0.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"commander": "^15.0.0",
		"reflect-metadata": "^0.2.2",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"glob": "^14.0.3",
		"rollup": "^4.67.4",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-native": "npm:typescript@^7.0.2",
		"vitest": "^5.1.0"
	}
}
